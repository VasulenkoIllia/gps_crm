!apps/api/prisma/migrations/**/*.sql
!apps/api/src/sql/**/*.sql

# internal-only: docs, design, and agent files stay out of the public repo (README is the only doc)
/docs/
/design/
/.claude/
AGENTS.md
CLAUDE.md
/graphify-out/


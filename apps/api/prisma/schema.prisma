// Models go here. Migrations: `npm run db:migrate` locally, additive only (expand / contract).
// Conventions: time `DateTime @db.Timestamptz`, money `BigInt` in kopecks with the suffix `_kop` (never Float), an index
// on every FK.
// Objects Prisma cannot describe (exclusion constraints, expression indexes, partitions in schema `part`) go into
// the SQL part of a migration as a commented block and into schema-invariants.int.test.ts.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  invited
  active
  blocked

  @@map("user_status")
}

enum AccessScope {
  all
  own

  @@map("access_scope")
}

enum AuthTokenType {
  invitation
  password_reset
  two_factor_challenge

  @@map("auth_token_type")
}

enum ActorKind {
  user
  system

  @@map("actor_kind")
}

enum BillingModel {
  month
  year

  @@map("billing_model")
}

enum CostSubjectType {
  server
  sim_plan
  addon

  @@map("cost_subject_type")
}

model Role {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId String      @map("role_id") @db.Uuid
  key    String
  scope  AccessScope

  role Role @relation(fields: [roleId], references: [id])

  @@id([roleId, key])
  @@map("role_permissions")
}

// Empty until the «Ролі та права» module: nothing reads it yet
model UserPermissionOverride {
  userId    String       @map("user_id") @db.Uuid
  key       String
  scope     AccessScope?
  isAllowed Boolean      @map("is_allowed")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, key])
  @@map("user_permission_overrides")
}

// The email is stored lower-case (a CHECK in the migration), so @unique means unique regardless of case (П3)
model User {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  roleId       String     @map("role_id") @db.Uuid
  status       UserStatus @default(invited)
  passwordHash String?    @map("password_hash")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy    String?    @map("updated_by") @db.Uuid

  role                Role                     @relation(fields: [roleId], references: [id])
  sessions            Session[]
  authTokens          AuthToken[]
  twoFactorCredential TwoFactorCredential?
  permissionOverrides UserPermissionOverride[]

  @@index([roleId])
  @@map("users")
}

// The cookie holds a random token, the table only its hash: a dump opens no session
model Session {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz
  usedAt    DateTime?     @map("used_at") @db.Timestamptz
  attempts  Int           @default(0)
  createdBy String?       @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model SignInThrottle {
  key            String   @id
  failures       Int
  firstFailureAt DateTime @map("first_failure_at") @db.Timestamptz
  lastFailureAt  DateTime @map("last_failure_at") @db.Timestamptz

  @@index([lastFailureAt])
  @@map("sign_in_throttle")
}

model TwoFactorCredential {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz
  // The newest TOTP step spent: a code is accepted once, and only a later step after it (П7)
  lastStep        Int?      @map("last_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User                    @relation(fields: [userId], references: [id])
  recoveryCodes TwoFactorRecoveryCode[]

  @@map("two_factor_credentials")
}

model TwoFactorRecoveryCode {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @map("code_hash")
  usedAt       DateTime? @map("used_at") @db.Timestamptz

  credential TwoFactorCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, codeHash])
  @@map("two_factor_recovery_codes")
}

// Partitioned by month in the migration; the partitions live in schema `part`, which Prisma does not describe.
// The runtime role may only insert and read here (06-quality.md §6.2.10), so nothing but core/activity writes.
model ActivityEvent {
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  id             String    @default(dbgenerated("uuidv7()")) @db.Uuid
  actorKind      ActorKind @map("actor_kind")
  actorId        String?   @map("actor_id") @db.Uuid
  action         String
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  subscriberId   String?   @map("subscriber_id") @db.Uuid
  changes        Json?
  snapshot       Json?
  ip             String?
  requestId      String?   @map("request_id")
  retentionClass String    @default("standard") @map("retention_class")

  @@id([occurredAt, id])
  @@index([actorId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([action, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([entityType, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([entityId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("activity_events")
}

// A package of records archived together (activity.md П5). The records themselves carry archive_batch_id.
model ArchiveBatch {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityType String    @map("entity_type")
  label      String
  itemCount  Int       @map("item_count")
  archivedAt DateTime  @default(now()) @map("archived_at") @db.Timestamptz
  archivedBy String?   @map("archived_by") @db.Uuid
  restoredAt DateTime? @map("restored_at") @db.Timestamptz
  restoredBy String?   @map("restored_by") @db.Uuid

  @@index([restoredAt, id(sort: Desc)])
  @@map("archive_batches")
}

// Filled by runJob only (system.md П1): one row per registered job
model JobHealth {
  name          String    @id
  registeredAt  DateTime  @default(now()) @map("registered_at") @db.Timestamptz
  runningSince  DateTime? @map("running_since") @db.Timestamptz
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz
  failureStreak Int       @default(0) @map("failure_streak")
  skippedItems  Int       @default(0) @map("skipped_items")
  lastError     String?   @map("last_error")

  @@map("job_health")
}

// One row per attempt, the newest few per job: see JOB_EVENTS_KEPT in job.repository.ts
model JobEvent {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobName      String   @map("job_name")
  trigger      String
  isSuccess    Boolean  @map("is_success")
  startedAt    DateTime @map("started_at") @db.Timestamptz
  finishedAt   DateTime @map("finished_at") @db.Timestamptz
  skippedItems Int      @default(0) @map("skipped_items")
  summary      Json?
  error        String?

  @@index([jobName, id(sort: Desc)])
  @@map("job_events")
}

// The reference lists (references.md). Every table: uuidv7, a name unique within its parent regardless of case, deactivation
// instead of deletion.
model Program {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  servers MonitoringServer[]
  tariffs Tariff[]
  addons  AddonProgram[]

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("programs")
}

model MonitoringServer {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  name           String
  nameNorm       String   @map("name_norm")
  url            String?
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  program Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  tariffs Tariff[]

  @@unique([programId, nameNorm])
  // What the foreign key of tariffs points at: a tariff cannot name a server of another program, whoever writes it
  @@unique([id, programId])
  @@index([archiveBatchId])
  @@map("monitoring_servers")
}

// The name repeats per period: one tariff by the month and by the year (references.md §10, D54)
model Tariff {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  programId      String       @map("program_id") @db.Uuid
  serverId       String       @map("server_id") @db.Uuid
  name           String
  nameNorm       String       @map("name_norm")
  billingModel   BillingModel @map("billing_model")
  priceKop       BigInt       @map("price_kop")
  // The first time a client or an object took it, set by their modules: from then on the price stands (П9)
  selectedAt     DateTime?    @map("selected_at") @db.Timestamptz
  isActive       Boolean      @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?      @map("archive_batch_id") @db.Uuid
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?      @map("created_by") @db.Uuid
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?      @map("updated_by") @db.Uuid

  program Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  server  MonitoringServer @relation(fields: [serverId, programId], references: [id, programId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([serverId, nameNorm, billingModel])
  @@index([programId, serverId, nameNorm, billingModel, id])
  @@index([archiveBatchId])
  @@map("tariffs")
}

model Addon {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  prices   AddonPrice[]
  programs AddonProgram[]

  @@index([archiveBatchId])
  @@map("addons")
}

// Added and never changed: a row stands until the next date, and a new date comes after the last (references.md П3, D57)
model AddonPrice {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  addonId   String   @map("addon_id") @db.Uuid
  priceKop  BigInt   @map("price_kop")
  validFrom DateTime @map("valid_from") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  addon Addon @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([addonId, validFrom])
  @@map("addon_prices")
}

model AddonProgram {
  addonId   String @map("addon_id") @db.Uuid
  programId String @map("program_id") @db.Uuid

  addon   Addon   @relation(fields: [addonId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@id([addonId, programId])
  @@index([programId])
  @@map("addon_programs")
}

model TrackerModel {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("tracker_models")
}

model SimOperator {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  plans SimPlan[]

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("sim_operators")
}

model SimPlan {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operatorId     String   @map("operator_id") @db.Uuid
  name           String
  nameNorm       String   @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  operator SimOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([operatorId, nameNorm])
  @@index([operatorId, sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("sim_plans")
}


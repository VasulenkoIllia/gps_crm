// Models go here. Migrations: `npm run db:migrate` locally, additive only (expand / contract).
// Conventions: time `DateTime @db.Timestamptz`, money `BigInt` in kopecks with the suffix `_kop` (never Float), an index
// on every FK.
// Objects Prisma cannot describe (exclusion constraints, expression indexes, partitions in schema `part`) go into
// the SQL part of a migration as a commented block and into schema-invariants.int.test.ts.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  invited
  active
  blocked

  @@map("user_status")
}

enum AccessScope {
  all
  own

  @@map("access_scope")
}

enum AuthTokenType {
  invitation
  password_reset
  two_factor_challenge

  @@map("auth_token_type")
}

enum ActorKind {
  user
  system

  @@map("actor_kind")
}

enum BillingModel {
  month
  year

  @@map("billing_model")
}

enum CostSubjectType {
  server
  sim_plan
  addon

  @@map("cost_subject_type")
}

enum SubscriberType {
  B2C
  B2B
  B2G

  @@map("subscriber_type")
}

enum SubscriberStatus {
  active
  partially_suspended
  suspended
  disconnected

  @@map("subscriber_status")
}

enum ContactChannel {
  telegram
  viber
  email

  @@map("contact_channel")
}

enum PaymentMethod {
  invoice
  vchasno
  iban

  @@map("payment_method")
}

model Role {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId String      @map("role_id") @db.Uuid
  key    String
  scope  AccessScope

  role Role @relation(fields: [roleId], references: [id])

  @@id([roleId, key])
  @@map("role_permissions")
}

// Empty until the «Ролі та права» module: nothing reads it yet
model UserPermissionOverride {
  userId    String       @map("user_id") @db.Uuid
  key       String
  scope     AccessScope?
  isAllowed Boolean      @map("is_allowed")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, key])
  @@map("user_permission_overrides")
}

// The email is stored lower-case (a CHECK in the migration), so @unique means unique regardless of case (П3)
model User {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  roleId       String     @map("role_id") @db.Uuid
  status       UserStatus @default(invited)
  passwordHash String?    @map("password_hash")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy    String?    @map("updated_by") @db.Uuid

  role                Role                     @relation(fields: [roleId], references: [id])
  sessions            Session[]
  authTokens          AuthToken[]
  twoFactorCredential TwoFactorCredential?
  permissionOverrides UserPermissionOverride[]
  managedSubscribers  Subscriber[]

  @@index([roleId])
  @@map("users")
}

// The cookie holds a random token, the table only its hash: a dump opens no session
model Session {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz
  usedAt    DateTime?     @map("used_at") @db.Timestamptz
  attempts  Int           @default(0)
  createdBy String?       @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model SignInThrottle {
  key            String   @id
  failures       Int
  firstFailureAt DateTime @map("first_failure_at") @db.Timestamptz
  lastFailureAt  DateTime @map("last_failure_at") @db.Timestamptz

  @@index([lastFailureAt])
  @@map("sign_in_throttle")
}

model TwoFactorCredential {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz
  // The newest TOTP step spent: a code is accepted once, and only a later step after it (П7)
  lastStep        Int?      @map("last_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User                    @relation(fields: [userId], references: [id])
  recoveryCodes TwoFactorRecoveryCode[]

  @@map("two_factor_credentials")
}

model TwoFactorRecoveryCode {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @map("code_hash")
  usedAt       DateTime? @map("used_at") @db.Timestamptz

  credential TwoFactorCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, codeHash])
  @@map("two_factor_recovery_codes")
}

// Partitioned by month in the migration; the partitions live in schema `part`, which Prisma does not describe.
// The runtime role may only insert and read here (06-quality.md §6.2.10), so nothing but core/activity writes.
model ActivityEvent {
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  id             String    @default(dbgenerated("uuidv7()")) @db.Uuid
  actorKind      ActorKind @map("actor_kind")
  actorId        String?   @map("actor_id") @db.Uuid
  action         String
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  subscriberId   String?   @map("subscriber_id") @db.Uuid
  changes        Json?
  snapshot       Json?
  ip             String?
  requestId      String?   @map("request_id")
  retentionClass String    @default("standard") @map("retention_class")

  @@id([occurredAt, id])
  @@index([actorId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([action, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([entityType, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([entityId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("activity_events")
}

// A package of records archived together (activity.md П5). The records themselves carry archive_batch_id.
model ArchiveBatch {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityType   String    @map("entity_type")
  label        String
  itemCount    Int       @map("item_count")
  // The client the package belongs to, for the level `own` of access. Empty for the reference lists, and once a client
  // deleted as a mistake leaves its packages behind.
  subscriberId String?   @map("subscriber_id") @db.Uuid
  archivedAt   DateTime  @default(now()) @map("archived_at") @db.Timestamptz
  archivedBy   String?   @map("archived_by") @db.Uuid
  restoredAt   DateTime? @map("restored_at") @db.Timestamptz
  restoredBy   String?   @map("restored_by") @db.Uuid

  subscriber Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([restoredAt, id(sort: Desc)])
  @@index([subscriberId])
  @@map("archive_batches")
}

// Filled by runJob only (system.md П1): one row per registered job
model JobHealth {
  name          String    @id
  registeredAt  DateTime  @default(now()) @map("registered_at") @db.Timestamptz
  runningSince  DateTime? @map("running_since") @db.Timestamptz
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz
  failureStreak Int       @default(0) @map("failure_streak")
  skippedItems  Int       @default(0) @map("skipped_items")
  lastError     String?   @map("last_error")

  @@map("job_health")
}

// One row per attempt, the newest few per job: see JOB_EVENTS_KEPT in job.repository.ts
model JobEvent {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobName      String   @map("job_name")
  trigger      String
  isSuccess    Boolean  @map("is_success")
  startedAt    DateTime @map("started_at") @db.Timestamptz
  finishedAt   DateTime @map("finished_at") @db.Timestamptz
  skippedItems Int      @default(0) @map("skipped_items")
  summary      Json?
  error        String?

  @@index([jobName, id(sort: Desc)])
  @@map("job_events")
}

// The reference lists (references.md). Every table: uuidv7, a name unique within its parent regardless of case, deactivation
// instead of deletion.
model Program {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  servers     MonitoringServer[]
  tariffs     Tariff[]
  addons      AddonProgram[]
  subscribers Subscriber[]

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("programs")
}

model MonitoringServer {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  name           String
  nameNorm       String   @map("name_norm")
  url            String?
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  program Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  tariffs Tariff[]

  @@unique([programId, nameNorm])
  // What the foreign key of tariffs points at: a tariff cannot name a server of another program, whoever writes it
  @@unique([id, programId])
  @@index([archiveBatchId])
  @@map("monitoring_servers")
}

// The name repeats per period: one tariff by the month and by the year (references.md §10, D54)
model Tariff {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  programId      String       @map("program_id") @db.Uuid
  serverId       String       @map("server_id") @db.Uuid
  name           String
  nameNorm       String       @map("name_norm")
  billingModel   BillingModel @map("billing_model")
  priceKop       BigInt       @map("price_kop")
  // The first time a client or an object took it, set by their modules: from then on the price stands (П9)
  selectedAt     DateTime?    @map("selected_at") @db.Timestamptz
  isActive       Boolean      @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?      @map("archive_batch_id") @db.Uuid
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?      @map("created_by") @db.Uuid
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?      @map("updated_by") @db.Uuid

  program Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  server  MonitoringServer @relation(fields: [serverId, programId], references: [id, programId], onDelete: Restrict, onUpdate: Restrict)

  subscribers       Subscriber[]
  subscriberPeriods SubscriberTariffPeriod[]

  @@unique([serverId, nameNorm, billingModel])
  // What the foreign key of subscribers points at: a client cannot hold a tariff of another program, whoever writes it
  @@unique([id, programId])
  @@index([programId, serverId, nameNorm, billingModel, id])
  @@index([archiveBatchId])
  @@map("tariffs")
}

model Addon {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  prices   AddonPrice[]
  programs AddonProgram[]

  @@index([archiveBatchId])
  @@map("addons")
}

// Added and never changed: a row stands until the next date, and a new date comes after the last (references.md П3, D57)
model AddonPrice {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  addonId   String   @map("addon_id") @db.Uuid
  priceKop  BigInt   @map("price_kop")
  validFrom DateTime @map("valid_from") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  addon Addon @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([addonId, validFrom])
  @@map("addon_prices")
}

model AddonProgram {
  addonId   String @map("addon_id") @db.Uuid
  programId String @map("program_id") @db.Uuid

  addon   Addon   @relation(fields: [addonId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@id([addonId, programId])
  @@index([programId])
  @@map("addon_programs")
}

model TrackerModel {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("tracker_models")
}

model SimOperator {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  plans SimPlan[]

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("sim_operators")
}

model SimPlan {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operatorId     String   @map("operator_id") @db.Uuid
  name           String
  nameNorm       String   @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  operator SimOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([operatorId, nameNorm])
  @@index([operatorId, sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("sim_plans")
}

model Contractor {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("contractors")
}

model DisconnectReason {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  nameNorm       String   @unique @map("name_norm")
  note           String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Set while deactivated: the package of the archive that brings the record back (references.md П4)
  archiveBatchId String?  @map("archive_batch_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@index([sortOrder, nameNorm, id])
  @@index([archiveBatchId])
  @@map("disconnect_reasons")
}

// Added and never changed, as addon_prices. The subject is one of three tables, so no foreign key: the service checks it.
model CostPrice {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType CostSubjectType @map("subject_type")
  subjectId   String          @map("subject_id") @db.Uuid
  costKop     BigInt          @map("cost_kop")
  validFrom   DateTime        @map("valid_from") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?         @map("created_by") @db.Uuid

  @@unique([subjectType, subjectId, validFrom])
  @@map("cost_prices")
}

// A file on the storage of core/files. A contract keeps every file it had: the newest one is the one shown (contracts.md).
model StoredFile {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storage      String
  key          String   @unique
  originalName String   @map("original_name")
  // What the content turned out to be, never what the browser said
  mime         String
  size         Int
  sha256       String
  ownerType    String   @map("owner_type")
  ownerId      String   @map("owner_id") @db.Uuid
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([ownerType, ownerId, id(sort: Desc)])
  @@map("files")
}

// The ranges of ID the client sets on the screen «Серії ID» (03-data-model.md §3.2, D35)
model SubscriberIdSeries {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  nameNorm   String   @unique @map("name_norm")
  rangeFrom  BigInt   @map("range_from")
  rangeTo    BigInt   @map("range_to")
  nextNumber BigInt   @map("next_number")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy  String?  @map("updated_by") @db.Uuid

  types SubscriberIdSeriesType[]

  @@map("subscriber_id_series")
}

// The primary key is what keeps a type in one series
model SubscriberIdSeriesType {
  type     SubscriberType @id
  seriesId String         @map("series_id") @db.Uuid

  series SubscriberIdSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@index([seriesId])
  @@map("subscriber_id_series_types")
}

// Partial and text_pattern_ops indexes live in the migration, see schema-invariants.int.test.ts
model Subscriber {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                BigInt           @unique
  legacyCode          String?          @unique @map("legacy_code")
  type                SubscriberType
  name                String
  nameNorm            String           @map("name_norm")
  taxId               String?          @map("tax_id")
  // Empty only after the transfer of data, the form asks for it (D36)
  crmUrl              String?          @map("crm_url")
  managerId           String           @map("manager_id") @db.Uuid
  graceDays           Int              @default(0) @map("grace_days")
  discountKop         BigInt           @default(0) @map("discount_kop")
  // What the open period of subscriber_tariff_periods says: the filters of the list and the count on a tariff read it
  // here, and on a million clients a join with the history would cost every page (D60)
  programId           String           @map("program_id") @db.Uuid
  tariffId            String           @map("tariff_id") @db.Uuid
  status              SubscriberStatus @default(disconnected)
  objectsActive       Int              @default(0) @map("objects_active")
  objectsSuspended    Int              @default(0) @map("objects_suspended")
  objectsDisconnected Int              @default(0) @map("objects_disconnected")
  note                String?
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy           String?          @map("created_by") @db.Uuid
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy           String?          @map("updated_by") @db.Uuid
  archivedAt          DateTime?        @map("archived_at") @db.Timestamptz
  archivedBy          String?          @map("archived_by") @db.Uuid
  archiveBatchId      String?          @map("archive_batch_id") @db.Uuid

  manager User    @relation(fields: [managerId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  tariff  Tariff  @relation(fields: [tariffId, programId], references: [id, programId], onDelete: Restrict, onUpdate: Restrict)

  tariffPeriods  SubscriberTariffPeriod[]
  contacts       Contact[]
  payers         PayerSubscriber[]
  contracts      Contract[]
  archiveBatches ArchiveBatch[]

  @@index([tariffId])
  @@index([programId])
  @@index([managerId])
  @@index([archiveBatchId])
  @@map("subscribers")
}

// [valid_from, valid_to): an exclusion in the migration keeps the periods of a client from overlapping (§3.4). A version
// fixed with the same date, or dropped before it began, stays as an empty period: the history of what was entered.
model SubscriberTariffPeriod {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriberId String    @map("subscriber_id") @db.Uuid
  tariffId     String    @map("tariff_id") @db.Uuid
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  tariff     Tariff     @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  @@index([subscriberId, validFrom(sort: Desc), id(sort: Desc)])
  @@index([tariffId])
  @@map("subscriber_tariff_periods")
}

model Contact {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriberId   String          @map("subscriber_id") @db.Uuid
  fullName       String          @map("full_name")
  fullNameNorm   String          @map("full_name_norm")
  position       String?
  phone          String
  phoneRev       String          @map("phone_rev")
  phone2         String?
  phone2Rev      String?         @map("phone2_rev")
  email          String?
  telegramChatId String?         @map("telegram_chat_id")
  viberChatId    String?         @map("viber_chat_id")
  // These two are empty only after the transfer of data, the form asks for them (D36)
  channel        ContactChannel?
  crmUrl         String?         @map("crm_url")
  isPrimary      Boolean         @default(false) @map("is_primary")
  billingNotify  Boolean         @default(true) @map("billing_notify")
  techNotify     Boolean         @default(true) @map("tech_notify")
  isActive       Boolean         @default(true) @map("is_active")
  note           String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?         @map("created_by") @db.Uuid
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?         @map("updated_by") @db.Uuid
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz
  archivedBy     String?         @map("archived_by") @db.Uuid
  archiveBatchId String?         @map("archive_batch_id") @db.Uuid

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@index([subscriberId])
  @@index([archiveBatchId])
  @@map("contacts")
}

model Payer {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String
  nameNorm         String        @map("name_norm")
  paymentMethod    PaymentMethod @map("payment_method")
  legalName        String?       @map("legal_name")
  taxId            String?       @map("tax_id")
  vchasnoEmail     String?       @map("vchasno_email")
  detailsContact   String?       @map("details_contact")
  paymentTermsNote String?       @map("payment_terms_note")
  note             String?
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy        String?       @map("created_by") @db.Uuid
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy        String?       @map("updated_by") @db.Uuid
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz
  archivedBy       String?       @map("archived_by") @db.Uuid
  archiveBatchId   String?       @map("archive_batch_id") @db.Uuid

  subscribers PayerSubscriber[]
  contracts   Contract[]

  @@index([archiveBatchId])
  @@map("payers")
}

// One payer pays for many clients (К6)
model PayerSubscriber {
  payerId      String   @map("payer_id") @db.Uuid
  subscriberId String   @map("subscriber_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid

  payer      Payer      @relation(fields: [payerId], references: [id], onDelete: Restrict)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  contracts  Contract[]

  @@id([payerId, subscriberId])
  @@index([subscriberId])
  @@map("payer_subscribers")
}

// The status is worked out from the dates (contracts.md П2а): today moves, so a stored one would go stale overnight
model Contract {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriberId   String    @map("subscriber_id") @db.Uuid
  payerId        String    @map("payer_id") @db.Uuid
  number         String
  numberNorm     String    @map("number_norm")
  signedOn       DateTime  @map("signed_on") @db.Date
  validUntil     DateTime  @map("valid_until") @db.Date
  terminatedOn   DateTime? @map("terminated_on") @db.Date
  note           String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  archivedBy     String?   @map("archived_by") @db.Uuid
  archiveBatchId String?   @map("archive_batch_id") @db.Uuid

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  payer      Payer      @relation(fields: [payerId], references: [id], onDelete: Restrict)
  // П1: only a payer of this client, whatever the code around it does
  payerLink  PayerSubscriber @relation(fields: [payerId, subscriberId], references: [payerId, subscriberId], onDelete: Restrict)

  @@index([subscriberId])
  @@index([payerId])
  @@index([archiveBatchId])
  @@map("contracts")
}

// Added and never changed, as addon_prices. The subject is one of three tables, so no foreign key: the service checks it.
model CostPrice {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType CostSubjectType @map("subject_type")
  subjectId   String          @map("subject_id") @db.Uuid
  costKop     BigInt          @map("cost_kop")
  validFrom   DateTime        @map("valid_from") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?         @map("created_by") @db.Uuid

  @@unique([subjectType, subjectId, validFrom])
  @@map("cost_prices")
}

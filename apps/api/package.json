{
  "name": "@gps_crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma generate && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "node --env-file-if-exists=../../.env --import tsx src/setup.ts",
    "routes:update": "UPDATE_ROUTE_INVENTORY=1 vitest run --root ../.. --project api src/route-inventory.test.ts",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@gps_crm/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "nodemailer": "10.1.7",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}

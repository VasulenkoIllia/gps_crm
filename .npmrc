# Install scripts of dependencies never run (supply chain: a compromised package cannot execute on install).
# What the project needs runs explicitly: `prisma generate` inside verify, typecheck and build.
# This setting also turns off pre and post scripts of our own package.json, so no script relies on them.
ignore-scripts=true
save-exact=true
# This file is committed and copied into the image: never put a registry token here.

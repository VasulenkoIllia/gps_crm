# Deployment identity: container (gps_crm-app), Traefik router and service names come from APP_NAME.
# It must be unique on the server.
APP_NAME=gps_crm
APP_DOMAIN=gpscrm.example.com

PORT=3000
NODE_ENV=production
TZ=Europe/Kyiv
LOG_LEVEL=info

# Optional HTTP Basic auth for the public demo (leave empty to disable; /health stays open)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

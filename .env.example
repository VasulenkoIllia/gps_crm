# Copy to .env and fill in. .env is never committed; keep it private (chmod 600 on the server).
# Locally the file sits in the repository root; on the server in /var/www/projects/gps_crm_<env>/.env

# --- Database (local and server) ---
# Password: letters and digits only (it goes into a URL), e.g. from `openssl rand -hex 24`
POSTGRES_DB=gps_crm
POSTGRES_USER=gps_crm
POSTGRES_PASSWORD=

# The role the running app connects as: gps_crm_app, DML only. The migration creates it, `npm run db:setup` (locally) and
# the `migrate` service (on a server) set this password. Letters and digits only, 16 or more: `openssl rand -hex 24`
APP_DB_PASSWORD=

# Key of the 2FA secrets, 32 bytes in base64: `openssl rand -base64 32`. Keep it in the password manager: without it
# nobody can sign in with a code from the phone, only with a recovery code, and 2FA has to be set up again.
SECRETS_KEY=

# --- First administrator ---
# Created once, on an empty users table, by the same step. Take the three lines out of .env after the first sign-in.
# FIRST_ADMIN_EMAIL=
# FIRST_ADMIN_NAME="<ПІБ>"
# FIRST_ADMIN_PASSWORD=

# --- Mail (optional) ---
# Without it invitations and password resets give a link to pass by hand. Port 587 with STARTTLS; with a login the app
# refuses a plain connection. Locally: 127.0.0.1, DEV_MAILPIT_SMTP_PORT, no login, letters land in Mailpit.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="GPS Облік <crm@example.com>"

# --- Application (optional, these are the defaults) ---
# APP_ROLE: all | api | worker. all and worker run the background jobs; one image, one role per container.
APP_ROLE=all
LOG_LEVEL=info

# --- Local development only ---
NODE_ENV=development
PORT=3000
# Where the app is opened, for the links in letters and the check of the Origin header. Default: Vite on 5173.
# APP_URL=http://localhost:5173
# In Docker the app gets DATABASE_URL from infra/compose.yml. Locally: the app as the runtime role, migrations as owner.
DATABASE_URL=postgresql://gps_crm_app:<APP_DB_PASSWORD>@127.0.0.1:15436/gps_crm
MIGRATION_DATABASE_URL=postgresql://gps_crm:<POSTGRES_PASSWORD>@127.0.0.1:15436/gps_crm
# Integration tests migrate and write here. The name must end in _test: anything else is refused.
TEST_DATABASE_URL=postgresql://gps_crm:<POSTGRES_PASSWORD>@127.0.0.1:15436/gps_crm_test
# End-to-end tests: the database is dropped on every run, so the name must end in _e2e. E2E_ADMIN_PASSWORD is any long
# test value. They run against the built app: `npm run build` first.
E2E_DATABASE_URL=postgresql://gps_crm:<POSTGRES_PASSWORD>@127.0.0.1:15436/gps_crm_e2e
E2E_ADMIN_PASSWORD=
E2E_SMTP_PORT=1026
E2E_MAILPIT_URL=http://127.0.0.1:8026
# The version on the screen «Система» and the folder with the status files of backup.sh. On a server compose sets both;
# left empty, the screen says that the backups are not set up.
# APP_VERSION=
# BACKUP_STATUS_DIR=
# Host ports of infra/compose.dev.yml, on 127.0.0.1 only
DEV_DB_PORT=15436
DEV_MAILPIT_UI_PORT=8026
DEV_MAILPIT_SMTP_PORT=1026

# --- Server only (infra/compose.yml); leave out locally ---
# Must equal the folder name: gps_crm_staging or gps_crm_production. It names the compose project, the database
# volume and the Traefik router, so never change it on a live environment.
# APP_NAME=gps_crm_staging
# APP_DOMAIN=gpscrm.example.com
#
# Basic Auth for staging, in htpasswd format. Create the hash with `htpasswd -nBC 12 <user>`: it asks for the password,
# so the password stays out of `ps` and the shell history. Take a random one of 20+ characters from a password manager.
# Keep the SINGLE QUOTES below and do NOT double the $ signs: inside single quotes compose reads the value literally.
# The $$ doubling from the Traefik docs is only for a hash written directly in a compose file; here it would break
# the password check. Without the quotes compose would treat $2y, $05 and the rest as variables.
# BASIC_AUTH_USERS='<user>:<htpasswd hash>'
#
# Production has no Basic Auth: set this to leave only the security headers. Default: headers and Basic Auth.
# ROUTER_MIDDLEWARES=gps_crm_production-headers
#
# Memory limits. About 65 containers share the host, so keep these; set larger values for production here.
# APP_MEM_LIMIT=768m
# DB_MEM_LIMIT=1g
